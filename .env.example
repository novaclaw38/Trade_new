# Copy this file to .env and fill in your keys. Never commit .env.

# --- Alpaca (https://alpaca.markets) -----------------------------------------
# Use PAPER keys from the Paper Trading section of the Alpaca dashboard.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Mode -------------------------------------------------------------------
# paper (default) = Alpaca's sandbox with simulated money.
# live            = REAL MONEY. Also requires the exact phrase below.
TRADING_MODE=paper
# LIVE_TRADING_ACKNOWLEDGED=I_UNDERSTAND_I_CAN_LOSE_REAL_MONEY

# --- What to trade ------------------------------------------------------------
SYMBOLS=SPY
TIMEFRAME=1Day            # 1Day (recommended) or 1Hour
DATA_FEED=iex             # iex is free; sip needs a paid Alpaca data plan
LOOP_MINUTES=15           # how often `run --loop` checks

# --- Strategy -----------------------------------------------------------------
FAST_SMA=20
SLOW_SMA=50
TREND_SMA=200
ATR_PERIOD=14
ATR_STOP_MULT=2.0         # stop-loss distance = this x ATR below entry
MAX_ATR_PCT=4.0           # skip entries when daily ATR is above 4% of price

# --- Risk (percent of account equity) -----------------------------------------
# Hard ceilings in code: 2% / 25% / 5% / 5 positions. Higher values are refused.
RISK_PER_TRADE_PCT=1.0    # max loss if a stop-loss is hit
MAX_POSITION_PCT=10       # max size of any one position
DAILY_LOSS_LIMIT_PCT=2.0  # halt new trades for the day after this drawdown
MAX_OPEN_POSITIONS=3

# Create a file with this name to stop all NEW trades immediately (exits still work).
KILL_SWITCH_FILE=STOP
DATA_DIR=data             # state.json and logs/ go here

# --- Optional AI confirmation (off by default) ---------------------------------
# When on, Claude reads recent news headlines and may VETO a buy. It can never
# start a trade. Needs an Anthropic API key (https://console.anthropic.com).
AI_CONFIRMATION_ENABLED=false
AI_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=      # uncomment and fill in only if you enable the AI layer
